NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Only needed by the maintenance scripts, never exposed to the browser.
CARDTRADER_API_TOKEN=replace-me
STRAPI_API_TOKEN=replace-me
# Optional separate token for the legacy backfill script.
STRAPI_BACKFILL_TOKEN=
PRICE_REVIEW_USERNAME=price-admin
PRICE_REVIEW_PASSWORD=replace-with-a-long-password
PRICE_REVIEW_SESSION_SECRET=replace-with-at-least-32-random-characters
PRICE_REVIEW_ENABLED=false

# Authentication tolerances for a busy or cold-starting Strapi instance.
AUTH_LOGIN_TIMEOUT_MS=45000
AUTH_SESSION_TIMEOUT_MS=30000

# Comma-separated site accounts allowed to see administration tool links.
# Price Review still requires its own PRICE_REVIEW_USERNAME/PASSWORD.
SITE_ADMIN_EMAILS=admin@example.com
